# Copy to .env (git-ignored) and fill in. Never commit .env or paste its values into chats or issues.

# --- Neon Postgres (ADR 0033): Connect → branch production, database placemap, pooling OFF, ".env" format
PGHOST=            # e.g. ep-xxxx-xxxx.us-east-1.aws.neon.tech  (must NOT contain "-pooler")
PGDATABASE=placemap
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# --- Grafana Cloud (ADR 0033): stack → OpenTelemetry → OTLP endpoint + access-policy token
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=    # e.g. Authorization=Basic <base64 of instanceId:token>

# --- Later phases (leave empty for now)
ORS_API_KEY=                   # Phase 3: openrouteservice
MBTA_API_KEY=                  # Phase 4: MBTA V3 API
NLR_API_KEY=                   # Phase 5: AFDC EV stations (developer.nlr.gov)
GITHUB_OAUTH_CLIENT_ID=        # Phase 6
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_ALERT_WEBHOOK_URL=     # deployment phase only (self-hosted Alertmanager); in development the webhook lives in Grafana Cloud
