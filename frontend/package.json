{
  "name": "placemap-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "types": "npx --yes -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript openapi.json --properties-required-by-default -o src/api-schema.ts",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@tanstack/react-query": "5.104.0",
    "downshift": "9.4.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "8.1.3",
    "reconnecting-eventsource": "1.6.5",
    "use-debounce": "10.1.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
