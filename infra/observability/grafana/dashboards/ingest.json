{
  "uid": "placemap-ingest",
  "title": "placemap \u00b7 Ingest",
  "description": "Import runs, throughput, batch timings and memory of the importer. Source: infra/observability/grafana/dashboards/ingest.json",
  "tags": [
    "placemap",
    "ingest"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(placemap_ingest_rows_total{job=\"placemap/ingest\"}, deployment_environment)",
          "refId": "env"
        },
        "definition": "label_values(placemap_ingest_rows_total{job=\"placemap/ingest\"}, deployment_environment)",
        "refresh": 2,
        "hide": 0,
        "current": {
          "text": "dev",
          "value": "dev"
        }
      },
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(placemap_ingest_rows_total{job=\"placemap/ingest\", deployment_environment=\"$env\"}, source)",
          "refId": "source"
        },
        "definition": "label_values(placemap_ingest_rows_total{job=\"placemap/ingest\", deployment_environment=\"$env\"}, source)",
        "refresh": 2,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failed runs",
      "description": "Counted over the dashboard's time range. A one-off run (tools/dev.sh ingest-once) reports once, at exit. The IngestRunFailed alert emails on each one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max_over_time(placemap_ingest_runs_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\", outcome=\"failed\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Completed runs",
      "description": "Counted over the dashboard's time range. A one-off run (tools/dev.sh ingest-once) reports once, at exit. Includes runs that found the source unchanged.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max_over_time(placemap_ingest_runs_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\", outcome=~\"complete|unchanged\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rows imported / s",
      "description": "Accepted rows per second across running imports, right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(placemap_ingest_rows_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\", outcome=\"accepted\"}[$__rate_interval])) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lost commit acknowledgements",
      "description": "Counted over the dashboard's time range. A one-off run (tools/dev.sh ingest-once) reports once, at exit. Batches retried after a commit that went through but whose reply was lost; the retry changed nothing (crash test C2).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max_over_time(placemap_ingest_batch_recommits_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Batches committed per second",
      "description": "Each batch of rows commits in its own transaction; the partitions of a run commit in parallel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (source) (rate(placemap_ingest_batches_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\"}[$__rate_interval]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rows per second by outcome",
      "description": "Accepted rows are stored; rejected rows go to ingest.reject (more than 2% fails the run); skipped rows are out of scope by design (outside the area or category).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(placemap_ingest_rows_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Time per batch: read, process, write",
      "description": "Spring Batch's own timings, all sources together (its metrics carry the step, not the source).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(spring_batch_item_read_seconds_sum{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval])) / sum(rate(spring_batch_item_read_seconds_count{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(spring_batch_item_process_seconds_sum{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval])) / sum(rate(spring_batch_item_process_seconds_count{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "parse, geocode, match"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(spring_batch_chunk_write_seconds_sum{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval])) / sum(rate(spring_batch_chunk_write_seconds_count{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "write and commit"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Batches written per second by partition",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (spring_batch_chunk_write_step_name) (rate(spring_batch_chunk_write_seconds_count{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{spring_batch_chunk_write_step_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Import jobs finished by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (spring_batch_job_status) (increase(spring_batch_job_seconds_count{job=\"placemap/ingest\", deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{spring_batch_job_status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Failed batch writes per second",
      "description": "A write that still fails after its retries ends the attempt; the run resumes on a later tick.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(spring_batch_chunk_write_seconds_count{job=\"placemap/ingest\", deployment_environment=\"$env\", spring_batch_chunk_write_status=\"FAILURE\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "failed writes"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM heap",
      "description": "The importer's heap (limit 1 GB in the plan's memory budget). It should stay flat however slow the database is.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"placemap/ingest\", deployment_environment=\"$env\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(jvm_memory_committed_bytes{job=\"placemap/ingest\", deployment_environment=\"$env\", area=\"heap\"})",
          "legendFormat": "committed"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Match decisions per second",
      "description": "What matching decided for each record: link to a place, create one, keep an earlier link, send to review, or leave unlinked.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (decision) (rate(placemap_ingest_matches_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\"}[$__rate_interval]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Batch retries",
      "description": "Retried after a deadlock, serialization failure or lost connection (at most 5 attempts per batch). 'Already committed' retries found that the earlier attempt had in fact committed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(placemap_ingest_batch_retries_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\"}[$__rate_interval]))",
          "legendFormat": "retries"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(placemap_ingest_batch_recommits_total{job=\"placemap/ingest\", deployment_environment=\"$env\", source=~\"$source\"}[$__rate_interval]))",
          "legendFormat": "already committed"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Database connections (Hikari)",
      "description": "Per run: 4 upsert connections plus the one holding the source lock.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(hikaricp_connections_active{job=\"placemap/ingest\", deployment_environment=\"$env\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(hikaricp_connections_idle{job=\"placemap/ingest\", deployment_environment=\"$env\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(hikaricp_connections_pending{job=\"placemap/ingest\", deployment_environment=\"$env\"})",
          "legendFormat": "waiting"
        }
      ]
    }
  ]
}
