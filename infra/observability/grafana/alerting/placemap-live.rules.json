{
 "title": "placemap-live",
 "folderUid": "placemap",
 "interval": 60,
 "rules": [
  {
   "uid": "placemap-live-feed-stale",
   "title": "LiveFeedStale",
   "condition": "C",
   "for": "2m",
   "noDataState": "OK",
   "execErrState": "Error",
   "labels": {
    "severity": "ticket",
    "service": "live-hub"
   },
   "annotations": {
    "summary": "the live {{ $labels.topic }} feed is stale",
    "description": "live-hub has had no answer from the {{ $labels.topic }} feed for over 3x its ttl, for 2 minutes. The map marks that data out of date and keeps showing the last values. See the runbook.",
    "runbook_url": "https://github.com/Naveen-1-1/place-discovery-map/blob/main/docs/runbooks/live-feed-stale.md"
   },
   "notification_settings": {
    "receiver": "email-placemap"
   },
   "data": [
    {
     "refId": "A",
     "relativeTimeRange": {
      "from": 600,
      "to": 0
     },
     "datasourceUid": "grafanacloud-prom",
     "model": {
      "refId": "A",
      "expr": "max by (topic) (placemap_live_feed_stale{job=\"placemap/live-hub\", topic!=\"departures\", deployment_environment!=\"benchmark\"})",
      "instant": true,
      "range": false
     }
    },
    {
     "refId": "C",
     "relativeTimeRange": {
      "from": 0,
      "to": 0
     },
     "datasourceUid": "__expr__",
     "model": {
      "refId": "C",
      "type": "threshold",
      "expression": "A",
      "conditions": [
       {
        "evaluator": {
         "type": "gt",
         "params": [
          0
         ]
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
