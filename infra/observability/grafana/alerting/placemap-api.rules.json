{
  "title": "placemap-api",
  "folderUid": "placemap",
  "interval": 30,
  "rules": [
    {
      "uid": "placemap-api-5xx",
      "title": "ApiServerErrors",
      "condition": "C",
      "for": "1m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": { "severity": "page", "service": "api" },
      "annotations": {
        "summary": "api is returning 5xx errors",
        "description": "More than 6 server errors per minute for a minute. Open the 'placemap · API RED' dashboard, then the traces with status=500.",
        "runbook_url": "https://github.com/Naveen-1-1/place-discovery-map/blob/main/docs/runbooks/alert-drill.md"
      },
      "notification_settings": { "receiver": "email-placemap" },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "sum(histogram_count(rate(http_server_requests_seconds{job=\"placemap/api\", status=~\"5..\"}[2m]))) or vector(0)",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 0, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [{ "evaluator": { "type": "gt", "params": [0.1] } }]
          }
        }
      ]
    },
    {
      "uid": "placemap-vt-pinning",
      "title": "VirtualThreadPinning",
      "condition": "C",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": { "severity": "ticket", "service": "placemap" },
      "annotations": {
        "summary": "virtual threads are being pinned",
        "description": "A virtual thread blocked while pinned to its carrier thread. Find the stack in JFR (jdk.VirtualThreadPinned); see the 'placemap · JVM & threads' dashboard."
      },
      "notification_settings": { "receiver": "email-placemap" },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "sum(increase(jvm_threads_virtual_pinned_seconds_count{job=~\"placemap/.*\"}[5m])) or vector(0)",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 0, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [{ "evaluator": { "type": "gt", "params": [0] } }]
          }
        }
      ]
    }
  ]
}
