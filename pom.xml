<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.naveen-1-1.placemap</groupId>
  <artifactId>placemap-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>placemap :: parent</name>
  <description>Boston place-discovery map: shared build configuration.</description>
  <url>https://github.com/Naveen-1-1/place-discovery-map</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <modules>
    <module>libs/concurrent</module>
    <module>libs/concurrent-jcstress</module>
    <module>libs/concurrent-jmh</module>
    <module>libs/observability</module>
    <module>db</module>
    <module>services/api</module>
    <module>services/ingest</module>
    <module>services/live-hub</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Platform BOM: manages JUnit, AssertJ, Jackson, Micrometer, OTel, Testcontainers, Caffeine, Flyway… -->
    <spring-boot.version>4.1.1</spring-boot.version>

    <!-- Concurrency verification tools -->
    <jcstress.version>0.16</jcstress.version>
    <jmh.version>1.37</jmh.version>
    <lincheck.version>3.7</lincheck.version>

    <!-- Must match versions managed by the Boot BOM (Flyway 12.4.0, OpenTelemetry API 1.62.0) -->
    <flyway.version>12.4.0</flyway.version>
    <postgresql.version>42.7.13</postgresql.version>
    <otel-logback-appender.version>2.28.0-alpha</otel-logback-appender.version>
    <datasource-micrometer.version>2.3.0</datasource-micrometer.version>

    <!-- Libraries the Boot BOM does not manage -->
    <commons-csv.version>1.14.1</commons-csv.version>
    <jts.version>1.20.0</jts.version>
    <archunit.version>1.5.1</archunit.version>
    <duckdb.version>1.5.5.1</duckdb.version>
    <h3.version>4.5.0</h3.version>
    <commons-text.version>1.15.0</commons-text.version>
    <proj4j.version>1.4.3</proj4j.version>
    <opening-hours-parser.version>0.29.0</opening-hours-parser.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <bucket4j.version>8.20.0</bucket4j.version>
    <!-- 3.13.2 is the newest stable release; the 4.0 line is still in beta. -->
    <wiremock.version>3.13.2</wiremock.version>

    <!-- Plugins -->
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <maven-dependency-plugin.version>3.10.0</maven-dependency-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jcstress</groupId>
        <artifactId>jcstress-core</artifactId>
        <version>${jcstress.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-core</artifactId>
        <version>${jmh.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-generator-annprocess</artifactId>
        <version>${jmh.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.lincheck</groupId>
        <artifactId>lincheck</artifactId>
        <version>${lincheck.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-logback-appender-1.0</artifactId>
        <version>${otel-logback-appender.version}</version>
      </dependency>
      <dependency>
        <groupId>net.ttddyy.observation</groupId>
        <artifactId>datasource-micrometer-spring-boot</artifactId>
        <version>${datasource-micrometer.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.naveen-1-1.placemap</groupId>
        <artifactId>concurrent</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.naveen-1-1.placemap</groupId>
        <artifactId>db</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.naveen-1-1.placemap</groupId>
        <artifactId>observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-csv</artifactId>
        <version>${commons-csv.version}</version>
      </dependency>
      <dependency>
        <groupId>org.locationtech.jts</groupId>
        <artifactId>jts-core</artifactId>
        <version>${jts.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.duckdb</groupId>
        <artifactId>duckdb_jdbc</artifactId>
        <version>${duckdb.version}</version>
      </dependency>
      <dependency>
        <groupId>com.uber</groupId>
        <artifactId>h3</artifactId>
        <version>${h3.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-text</artifactId>
        <version>${commons-text.version}</version>
      </dependency>
      <dependency>
        <groupId>org.locationtech.proj4j</groupId>
        <artifactId>proj4j</artifactId>
        <version>${proj4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.locationtech.proj4j</groupId>
        <artifactId>proj4j-epsg</artifactId>
        <version>${proj4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bucket4j</groupId>
        <artifactId>bucket4j_jdk17-core</artifactId>
        <version>${bucket4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock-standalone</artifactId>
        <version>${wiremock.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.poole</groupId>
        <artifactId>OpeningHoursParser</artifactId>
        <version>${opening-hours-parser.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.6,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
